{
  "name": "eclisse",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start-bot": "node scripts/bot-server.js",
    "build:tailwind": "postcss src/tailwind.css -o src/tailwind.compiled.css",
