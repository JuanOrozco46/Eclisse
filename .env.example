# Variables para Supabase (Frontend + Backend)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_clave_anonima_publica

# Clave privada exclusiva de backend (Vercel Serverless Functions) - ¡NUNCA EN ANGULAR!
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_privada

# Integración WhatsApp - Evolution API (Backend Vercel)
EVOLUTION_API_URL=https://tu-instancia-evolution.onrender.com
EVOLUTION_API_KEY=tu_clave_secreta_evolution
EVOLUTION_INSTANCE_NAME=ECLISSE_WA_01

# Clave Gemini IA para Luisa Bot
GEMINI_API_KEY=tu_clave_gemini_api

# Secreto obligatorio para validación de Webhook de WhatsApp
WEBHOOK_SECRET=tu_secreto_para_webhook_whatsapp

# Teléfono de WhatsApp del dueño/administrador para alertas automáticas de fallos (ej: 573004057195)
ADMIN_WHATSAPP_PHONE=573004057195
